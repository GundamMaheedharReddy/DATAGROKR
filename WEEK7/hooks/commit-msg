#!/usr/bin/env bash
# commit-msg hook: enforce Conventional Commits  ->  type(scope): subject
# Allowed types: feat fix docs style refactor perf test build ci chore revert
# Merge / Revert / fixup! commits are let through.
msg_file="$1"
first_line="$(head -n 1 "$msg_file")"

case "$first_line" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

regex='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9_./-]+\))?!?: .{3,72}$'
if ! [[ "$first_line" =~ $regex ]]; then
  cat >&2 <<MSG
✖ commit-msg: "$first_line"
  does not follow Conventional Commits:

      <type>(<optional scope>): <subject, 3-72 chars>

  Examples:  feat(calculator): add multiply()
             fix: handle empty input
             chore(release): bump version to 1.0.0
  Types:     feat fix docs style refactor perf test build ci chore revert
MSG
  exit 1
fi
exit 0
